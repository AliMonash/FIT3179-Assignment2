{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Proportional-symbol map of the First Nations digital inclusion gap by Australian state and territory.",
  "width": 700,
  "height": 500,
  "title": {
    "text": "The First Nations digital gap is largest in remote jurisdictions",
    "subtitle": "Circle area represents the 2025 digital inclusion gap against non-First Nations Australians."
  },
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/syncfusion/flutter-examples/dee00ad6c7f785dcf5e7f326c6d528ed5b2643bc/assets/australia.json",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E8ECEF",
        "stroke": "white",
        "strokeWidth": 1.5
      }
    },
    {
      "data": {
        "url": "data/chart7_first_nations_gap.csv",
        "format": {
          "type": "csv"
        }
      },
      "mark": {
        "type": "circle",
        "opacity": 0.78,
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "gap_points",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "domain": [
              0,
              18
            ],
            "range": [
              20,
              2200
            ]
          },
          "legend": {
            "title": "Digital gap (points)",
            "values": [
              5,
              10,
              15
            ]
          }
        },
        "color": {
          "field": "gap_points",
          "type": "quantitative",
          "scale": {
            "scheme": "orangered",
            "domain": [
              0,
              18
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State / territory"
          },
          {
            "field": "first_nations_adii",
            "type": "quantitative",
            "title": "First Nations ADII",
            "format": ".1f"
          },
          {
            "field": "gap_points",
            "type": "quantitative",
            "title": "Digital gap",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/chart7_first_nations_gap.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "filter": "datum.abbr !== 'ACT'"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#202124",
        "dy": -22
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "abbr",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "url": "data/chart7_first_nations_gap.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "filter": "datum.gap_points >= 8"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "white"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "gap_points",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 149.12,
            "lat": -35.28,
            "label": "ACT 0.3"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": "bold",
        "align": "left",
        "dx": 7,
        "dy": -6,
        "color": "#202124"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "background": null,
    "view": {
      "stroke": null
    },
    "title": {
      "font": "IBM Plex Sans",
      "fontSize": 20,
      "fontWeight": "bold",
      "subtitleFont": "IBM Plex Sans",
      "subtitleFontSize": 12,
      "subtitleColor": "#6C757D",
      "anchor": "start",
      "color": "#212529"
    },
    "legend": {
      "labelFont": "IBM Plex Sans",
      "titleFont": "IBM Plex Sans"
    },
    "axis": {
      "labelFont": "IBM Plex Sans",
      "titleFont": "IBM Plex Sans"
    }
  }
}