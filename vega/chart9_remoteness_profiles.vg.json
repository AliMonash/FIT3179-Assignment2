{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Parallel-coordinates profile of 2025 ADII dimensions by remoteness.",
  "width": 700,
  "height": 390,
  "title": {
    "text": "Digital inclusion falls as remoteness increases",
    "subtitle": "Each line is a remoteness category crossing four 2025 ADII dimensions."
  },
  "data": {
    "url": "data/chart9_remoteness_profiles.csv",
    "format": {
      "type": "csv"
    }
  },
  "layer": [
    {
      "data": {
        "values": [
          {
            "metric": "Overall ADII"
          },
          {
            "metric": "Access"
          },
          {
            "metric": "Affordability"
          },
          {
            "metric": "Digital Ability"
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#CED4DA",
        "strokeWidth": 1.4
      },
      "encoding": {
        "x": {
          "field": "metric",
          "type": "ordinal",
          "sort": [
            "Overall ADII",
            "Access",
            "Affordability",
            "Digital Ability"
          ]
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "opacity": 0.8
      },
      "encoding": {
        "x": {
          "field": "metric",
          "type": "ordinal",
          "sort": [
            "Overall ADII",
            "Access",
            "Affordability",
            "Digital Ability"
          ],
          "axis": {
            "title": null,
            "labelAngle": 0,
            "labelFontSize": 12,
            "labelPadding": 10
          }
        },
        "y": {
          "field": "score",
          "type": "quantitative",
          "scale": {
            "domain": [
              55,
              80
            ]
          },
          "axis": {
            "title": "ADII score",
            "tickCount": 6,
            "grid": false
          }
        },
        "color": {
          "field": "remoteness",
          "type": "nominal",
          "sort": [
            "Major cities",
            "Inner regional",
            "Outer regional",
            "Remote",
            "Very remote"
          ],
          "scale": {
            "domain": [
              "Major cities",
              "Inner regional",
              "Outer regional",
              "Remote",
              "Very remote"
            ],
            "range": [
              "#173B72",
              "#2F6FDB",
              "#63B6E5",
              "#F2A06B",
              "#F05A45"
            ]
          },
          "legend": {
            "title": "Remoteness",
            "orient": "bottom",
            "columns": 3
          }
        },
        "detail": {
          "field": "remoteness"
        },
        "order": {
          "field": "metric_order",
          "type": "ordinal"
        },
        "tooltip": [
          {
            "field": "remoteness",
            "type": "nominal",
            "title": "Area"
          },
          {
            "field": "metric",
            "type": "nominal",
            "title": "Measure"
          },
          {
            "field": "score",
            "type": "quantitative",
            "title": "Score",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 100,
        "stroke": "white",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "field": "metric",
          "type": "ordinal",
          "sort": [
            "Overall ADII",
            "Access",
            "Affordability",
            "Digital Ability"
          ]
        },
        "y": {
          "field": "score",
          "type": "quantitative",
          "scale": {
            "domain": [
              55,
              80
            ]
          }
        },
        "color": {
          "field": "remoteness",
          "type": "nominal",
          "sort": [
            "Major cities",
            "Inner regional",
            "Outer regional",
            "Remote",
            "Very remote"
          ],
          "scale": {
            "domain": [
              "Major cities",
              "Inner regional",
              "Outer regional",
              "Remote",
              "Very remote"
            ],
            "range": [
              "#173B72",
              "#2F6FDB",
              "#63B6E5",
              "#F2A06B",
              "#F05A45"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "remoteness",
            "type": "nominal",
            "title": "Area"
          },
          {
            "field": "metric",
            "type": "nominal",
            "title": "Measure"
          },
          {
            "field": "score",
            "type": "quantitative",
            "title": "Score",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.remoteness === 'Very remote'"
        }
      ],
      "mark": {
        "type": "text",
        "dy": 14,
        "fontSize": 10,
        "fontWeight": "bold",
        "color": "#B23A2D"
      },
      "encoding": {
        "x": {
          "field": "metric",
          "type": "ordinal",
          "sort": [
            "Overall ADII",
            "Access",
            "Affordability",
            "Digital Ability"
          ]
        },
        "y": {
          "field": "score",
          "type": "quantitative",
          "scale": {
            "domain": [
              55,
              80
            ]
          }
        },
        "text": {
          "field": "score",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "metric": "Access",
            "score": 57.4,
            "label": "Largest drop: Access"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "dy": -10,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#B23A2D"
      },
      "encoding": {
        "x": {
          "field": "metric",
          "type": "ordinal",
          "sort": [
            "Overall ADII",
            "Access",
            "Affordability",
            "Digital Ability"
          ]
        },
        "y": {
          "field": "score",
          "type": "quantitative",
          "scale": {
            "domain": [
              55,
              80
            ]
          }
        },
        "text": {
          "field": "label"
        }
      }
    }
  ],
  "config": {
    "background": null,
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "IBM Plex Sans",
      "titleFont": "IBM Plex Sans",
      "labelColor": "#343A40",
      "titleColor": "#343A40",
      "gridColor": "#E9ECEF",
      "domainColor": "#ADB5BD",
      "tickColor": "#CED4DA"
    },
    "title": {
      "font": "IBM Plex Sans",
      "fontSize": 20,
      "fontWeight": "bold",
      "subtitleFont": "IBM Plex Sans",
      "subtitleFontSize": 12,
      "subtitleColor": "#6C757D",
      "anchor": "start",
      "color": "#212529"
    },
    "legend": {
      "labelFont": "IBM Plex Sans",
      "titleFont": "IBM Plex Sans"
    }
  }
}